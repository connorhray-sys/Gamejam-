	if body.name == "Player" and not dead:
		emit_signal("death")  
		dead = true 
		set_physics_process(false) 
		animated_sprite.stop() 
		await get_tree().create_timer(1.0).timeout 
		if is_inside_tree(): 
			get_tree().reload_current_scene()

func _on_bouncy_timer_timeout() -> void:
	emit_signal("normal")
	await get_tree().create_timer(3.0).timeout
	emit_signal("icy")
	on_ice = true
	await get_tree().create_timer(3).timeout
	emit_signal("conveyor") 
	on_ice = false
	var x = randi_range(1, 2)
	if x == 1:
		forced_direction = 0.4
	else:
		forced_direction = -0.4
	await get_tree().create_timer(3.0).timeout
	emit_signal("bounce")
	forced_direction = 0.0
	bouncy = true
	bounce_force = randi_range(-100, -400)
	await get_tree().create_timer(3.0).timeout
	bouncy = false


func _on_timer_timeout() -> void:
	crazy = true


func _on_kill_zone_body_entered(body: Node2D) -> void:
	if body.name == "Player":
		if body.name == "Player" and not dead: 
			emit_signal("death") 
			dead = true 
			set_physics_process(false) 
			animated_sprite.stop() 
			await get_tree().create_timer(1.0).timeout 
			if is_inside_tree(): 
				get_tree().reload_current_scene()


